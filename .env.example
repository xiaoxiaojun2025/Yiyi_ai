# 项目配置模板
# 复制此文件为 .env 并填入真实值

# ==================== API 配置 ====================
# SiliconFlow API Key（从 https://siliconflow.cn 获取）
SILICONFLOW_API_KEY=sk-your-api-key-here

# Ollama 本地服务地址
OLLAMA_BASE_URL=http://localhost:11434

# ==================== 模型配置 ====================
# 云端模型名称
CLOUD_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 本地模型名称
LOCAL_MODEL=qwen3:0.6b

# ==================== 超时配置 ====================
# 云端 API 超时时间（秒）
CLOUD_TIMEOUT=120

# 本地模型超时时间（秒）
LOCAL_TIMEOUT=60

# ==================== 数据配置 ====================
# 最大会话数量
MAX_CONVERSATIONS=50

# 数据目录
DATA_DIR=data

# ==================== UI 配置 ====================
# 窗口尺寸
WINDOW_WIDTH=1200
WINDOW_HEIGHT=800

# ==================== 传感器配置 ====================
# 是否使用真实传感器（True/False）
USE_REAL_SENSOR=False

# I2C 总线号
I2C_BUS=1

# MAX30102 I2C 地址（十六进制）
MAX30102_I2C_ADDRESS=0x57

# ==================== PDF 导出配置 ====================
# PDF 输出目录
PDF_OUTPUT_DIR=out

# PDF 字体（中文字体）
PDF_FONT=SimSun